{
  "name": "@zzf1sh/specflow-ai",
  "version": "0.1.0",
  "description": "8-stage AI-assisted development workflow platform — Claude Code MCP server + local approval dashboard (SPEC → REQUIREMENTS → DESIGN → DEVELOP → TEST → BUILD → DEPLOY → OPS)",
  "type": "module",
  "bin": {
    "specflow-ai": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run build:dashboard",
    "build:dashboard": "vite build --config dashboard_frontend/vite.config.ts && node scripts/copy-dashboard.mjs",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "dev:dashboard": "vite --config dashboard_frontend/vite.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "chokidar": "^3.5.3",
    "fastify": "^5.8.5",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
